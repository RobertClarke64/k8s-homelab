{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 10,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=helm depName=(?<depName>[^\\s]+) repo=(?<registryUrl>[^\\s]+)\\ntargetRevision:\\s*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm"
    }
  ]
}
