{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 10,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts in root-app/values.yaml",
      "managerFilePatterns": ["root-app/values\\.yaml"],
      "matchStrings": [
        "#\\s?renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) chart=(?<registryUrl>.*?)\\s?targetRevision:\\s?\\'?(?<currentValue>[\\w+\\.\\-]*)'"
      ],
      "depNameTemplate": "helm",
      "datasourceTemplate": "helm"
    }
  ]
}
