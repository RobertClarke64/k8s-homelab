#!/usr/bin/env python3
"""Generate Matrix appservice registration files."""

import argparse
import secrets
import sys
import yaml


def generate_token() -> str:
    """Generate a 64-character hex token."""
    return secrets.token_hex(32)


def generate_registration(
    id: str,
    url: str,
    sender_localpart: str,
    domain: str,
    user_prefix: str | None = None,
    alias_prefix: str | None = None,
    rate_limited: bool = False,
) -> dict:
    """Generate a registration dict."""
    registration = {
        "id": id,
        "url": url,
        "as_token": generate_token(),
        "hs_token": generate_token(),
        "sender_localpart": sender_localpart,
        "rate_limited": rate_limited,
        "namespaces": {
            "users": [],
            "aliases": [],
            "rooms": [],
        },
    }

    escaped_domain = domain.replace(".", r"\.")

    if user_prefix:
        registration["namespaces"]["users"].append({
            "exclusive": True,
            "regex": f"@{user_prefix}.*:{escaped_domain}",
        })

    if alias_prefix:
        registration["namespaces"]["aliases"].append({
            "exclusive": True,
            "regex": f"#{alias_prefix}.*:{escaped_domain}",
        })

    return registration


def main():
    parser = argparse.ArgumentParser(
        description="Generate Matrix appservice registration files",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s --id discord --url http://mautrix-discord:29328 \\
           --sender _discord_bot --domain example.com \\
           --user-prefix _discord_ --alias-prefix _discord_

  %(prog)s --id slack --url http://mautrix-slack:29328 \\
           --sender _slack_bot --domain example.com \\
           --user-prefix _slack_ -o slack-registration.yaml
""",
    )

    parser.add_argument(
        "--id",
        required=True,
        help="Unique identifier for the appservice",
    )
    parser.add_argument(
        "--url",
        required=True,
        help="URL where the homeserver can reach the appservice",
    )
    parser.add_argument(
        "--sender",
        required=True,
        dest="sender_localpart",
        help="Localpart for the appservice bot user (e.g., _discord_bot)",
    )
    parser.add_argument(
        "--domain",
        required=True,
        help="Matrix server domain (e.g., example.com)",
    )
    parser.add_argument(
        "--user-prefix",
        help="Prefix for user namespace regex (e.g., _discord_)",
    )
    parser.add_argument(
        "--alias-prefix",
        help="Prefix for alias namespace regex (e.g., _discord_)",
    )
    parser.add_argument(
        "--rate-limited",
        action="store_true",
        help="Enable rate limiting for the appservice",
    )
    parser.add_argument(
        "-o", "--output",
        help="Output file (default: stdout)",
    )

    args = parser.parse_args()

    registration = generate_registration(
        id=args.id,
        url=args.url,
        sender_localpart=args.sender_localpart,
        domain=args.domain,
        user_prefix=args.user_prefix,
        alias_prefix=args.alias_prefix,
        rate_limited=args.rate_limited,
    )

    output = yaml.dump(registration, default_flow_style=False, sort_keys=False)

    if args.output:
        with open(args.output, "w") as f:
            f.write(output)
        print(f"Registration written to {args.output}", file=sys.stderr)
    else:
        print(output)


if __name__ == "__main__":
    main()
