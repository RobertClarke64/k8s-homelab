{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "helmv3"
  ],
  "helmv3": {
    "managerFilePatterns": [
      "/(^|/)Chart\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "helmv3"
      ],
      "rangeStrategy": "bump",
      "automerge": false
    }
  ]
}
